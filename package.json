{
  "name": "@local/dsh-workspace-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workspace-scoped built-in browser control for DSH Desktop over CDP",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
