+/**
+ * Injectable reads for the ambiguous-window tests: one shell evaluate per page
+ * and one frame-probe evaluate per probed webview. `probes` maps a webview id
+ * to the value its probe resolves (a string, or an Error to throw).
+ */
+function probeDeps({ shell = SAME_SHELL, probes = {} } = {}) {
+  const connections = []
+  const closed = []
+  const expressions = []
+  return {
+    connections,
+    closed,
+    expressions,
+    deps: {
+      async connect(target) {
+        connections.push(target.id)
+        const failure = probes[target.id]
+        if (failure instanceof Error) throw failure
+        return {
+          targetId: target.id,
+          close() {
+            closed.push(target.id)
+          },
+        }
+      },
+      async evaluate(session, expression) {
+        expressions.push({ targetId: session.targetId, expression })
+        if (session.targetId === 'window-1') return JSON.stringify(shell)
+        return probes[session.targetId] ?? 'raf-timeout'
+      },
+    },
+  }
+}
